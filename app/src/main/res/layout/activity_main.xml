
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fit_background"
    android:gravity="center">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FitTrack"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/fit_primary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Daily Fitness Companion"
            android:textSize="16sp"
            android:textColor="@color/fit_text"
            android:layout_marginTop="10dp"/>

        <ProgressBar
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminateTint="@color/fit_primary"
            android:layout_marginTop="35dp"/>

    </LinearLayout>

</RelativeLayout>
